# Database (port 5433 to avoid conflicts with local PostgreSQL)
DATABASE_URL=postgres://agora:agora@localhost:5433/agora?sslmode=disable

# Bazaar API
BAZAAR_API_URL=https://api.cdp.coinbase.com/platform/v2/x402/discovery/resources
BAZAAR_PAGE_SIZE=1000

# Crawler
CRAWLER_CONCURRENCY=1
CRAWLER_MAX_RETRIES=10

# Indexer (V2 on-chain transaction tracking via Alchemy RPC — optional)
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
INDEXER_BLOCK_RANGE=2000
INDEXER_START_BLOCK=25000000

# Embedding Sidecar
EMBED_URL=http://localhost:8100

# CDP SQL API (V1 Indexer — optional, requires Coinbase Developer Platform keys)
CDP_API_KEY_ID=your-key-id-here
CDP_API_KEY_SECRET=your-secret-key-here

# API Server
API_PORT=8080

# Prober (health check + x402 compliance probing)
PROBER_CONCURRENCY=20
PROBER_TIMEOUT_SECS=10
PROBER_BATCH_SIZE=500
PROBER_DOMAIN_DELAY_MS=200
